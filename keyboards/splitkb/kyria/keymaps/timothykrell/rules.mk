OLED_ENABLE = yes
ENCODER_ENABLE = no        # no knobs fitted on this board
RGBLIGHT_ENABLE = yes
MOUSEKEY_ENABLE = yes      # MS_* keys on the ADJUST and G-RAISE layers
CAPS_WORD_ENABLE = yes
COMBO_ENABLE = yes         # both Shift thumbs together -> Caps Word

# Space savers: features this keymap never uses (the 32u4 has only 28 KB for firmware).
MAGIC_ENABLE = no
SPACE_CADET_ENABLE = no
GRAVE_ESC_ENABLE = no
